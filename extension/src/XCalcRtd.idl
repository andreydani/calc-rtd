/* Reference definition of the add-in interface.
 *
 * The .rdb shipped in the extension is generated by tools/build_oxt.py,
 * which mirrors this file - change both together. With the LibreOffice SDK
 * you can also compile it the classic way:
 *
 *   unoidl-write <office>/program/types.rdb <office>/program/types/offapi.rdb \
 *       XCalcRtd.idl XCalcRtd.rdb
 */
module com { module github { module calcrtd {

interface XCalcRtd
{
    /** Excel-compatible RTD(ProgID; server; topic1; [topic2]; ...) */
    com::sun::star::sheet::XVolatileResult rtd(
        [in] string progId,
        [in] any server,
        [in] sequence< any > topics );

    /** Same function under the name Excel puts on the clipboard: _xlfn.RTD */
    com::sun::star::sheet::XVolatileResult xlfnRtd(
        [in] string progId,
        [in] any server,
        [in] sequence< any > topics );
};

}; }; };
